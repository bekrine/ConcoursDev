# ==============================================================================
# ConcoursDev Maroc — Variables d'Environnement (Exemple Sécurisé)
# Aucune clé réelle ou secrète ne doit figurer dans ce fichier ou dans le dépôt.
# ==============================================================================

# Application Port & Mode
PORT=3000
NODE_ENV=development

# Supabase PostgreSQL & Auth (Configuration recommandée pour ConcoursDev Maroc)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=votre_cle_publique_anon_ou_publishable

# Secret côté serveur (Strictement réservé aux Edge Functions ou Backend privé)
# SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_privee

# Modèle d'IA / Gemini (Côté serveur exclusivement si activé)
# GEMINI_API_KEY=votre_cle_gemini_securisee
# GEMINI_MODEL=gemini-2.5-flash

# Portail national de recherche
EMPLOI_PUBLIC_API_URL=https://www.emploi-public.ma/api/v1
MAX_DOC_DOWNLOAD_MB=25
